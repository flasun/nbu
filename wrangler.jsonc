{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "nbu",
  "compatibility_date": "2026-10-01",
  // Tiny Worker on "/" only: serves index.html from ASSETS and counts page views (totals only,
  // no visitor id). Every other path stays static-only. "/" serves index.html. Anything missing
  // gets a plain 404, never the page: a missing script answered with HTML would break the offline copy.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/"],
  },
  // Page-view counter. Dataset is created on first write. Totals only, no visitor id.
  "analytics_engine_datasets": [{ "binding": "PAGEVIEWS", "dataset": "nbu_pageviews" }],
  // Keep Ryan's current state (live v7: logs/traces off). Matches what earlier deploys sent.
  "observability": { "enabled": false },
  // Required for pull-request preview builds (`wrangler preview`); empty is fine.
  "previews": {},
}
